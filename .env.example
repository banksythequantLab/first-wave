# Qloo hackathon key (emailed after the API key request form). Hackathon keys ONLY work on this base URL.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# 1 = force fake fixtures. Mock is also used automatically when QLOO_API_KEY is empty.
QLOO_MOCK=0
# Optional OpenAI-compatible LLM for launch kits. Without it, a deterministic template is used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
